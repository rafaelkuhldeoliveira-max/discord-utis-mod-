# Somente token de BOT OFICIAL — nunca token de usuario.
DISCORD_BOT_TOKEN=TOKEN_DO_BOT
# Servidor onde os dois participantes devem estar.
DISCORD_GUILD_ID=ID_DO_SERVIDOR
# Conta administradora que pode configurar o painel: NAO e nenhum dos dois campos de vinculo.
DISCORD_OWNER_ID=ID_DA_CONTA_ADMINISTRADORA
# IDs da pessoa que sera seguida e da pessoa acompanhada sao digitados no painel Oraculo X > Coleira.
# A autenticacao entre o painel e o bot e gerada automaticamente no computador.
COLEIRA_PORT=37659
